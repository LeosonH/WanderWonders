<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Wander Wonders</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>WanderWonders</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(WW_GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.lifestyle</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Wander Wonders uses your step total to calculate earned Glow.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Wander Wonders does not write Health data.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Wander Wonders can check whether you are near a park without storing your location.</string>
	<key>NSMotionUsageDescription</key>
	<string>Wander Wonders can count steps taken during an active Wander when Health access is unavailable.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>WWGoogleClientID</key>
	<string>$(WW_GOOGLE_CLIENT_ID)</string>
	<key>WWGoogleServerClientID</key>
	<string>$(WW_GOOGLE_SERVER_CLIENT_ID)</string>
	<key>WWPrivacyURL</key>
	<string>$(WW_PRIVACY_URL)</string>
	<key>WWSupabasePublishableKey</key>
	<string>$(WW_SUPABASE_PUBLISHABLE_KEY)</string>
	<key>WWSupabaseURL</key>
	<string>$(WW_SUPABASE_URL)</string>
	<key>WWSupportURL</key>
	<string>$(WW_SUPPORT_URL)</string>
</dict>
</plist>
